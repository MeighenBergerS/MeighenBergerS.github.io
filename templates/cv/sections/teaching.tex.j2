<% set levels = {'phd': 'PhD mentoring', 'masters': "Master's co-supervision", 'junior': 'Undergraduate and junior co-supervision'} %>
\section{Teaching and Mentoring}


\denseouterlist{
\entry{<< teaching.lecturing[0]|tex >>}

<% if private and private.students %>
<% for lvl, label in levels.items() %>
<% set ss = private.students|selectattr('level', 'equalto', lvl)|list %>
<% if ss %>
\entry{\textbf{<< label|tex >>}. <% for s in ss %><< s.name|tex >> (<< s.institution|tex >>)<% if s.title %>, "<< s.title|tex >>"<% endif %><% if s.note %>, << s.note|tex >><% endif %>.<% if not loop.last %> <% endif %><% endfor %>}

<% endif %>
<% endfor %>
<% else %>
\entry{\textbf{Mentoring}. Mentored << stats.supervision.phd_words >> PhD students. Co-supervised << stats.supervision.masters_words >> Master's students and << stats.supervision.junior_words >> undergraduate or junior research projects.}

<% endif %>
<% for l in teaching.lecturing[1:] %>
\entry{<< l|tex >>}

<% endfor %>
<% for c in teaching.community %>
\entry{<< c|tex >>}

<% endfor %>
}
