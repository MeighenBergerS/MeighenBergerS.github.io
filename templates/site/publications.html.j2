{% extends "base.html.j2" %}
{% from "macros.html.j2" import paper, stat %}
{% block title %}Publications · {{ profile.name }}{% endblock %}
{% block content %}
<h1>Publications</h1>
<p class="lede">
  {{ stats.refereed }} refereed papers and {{ stats.conference }} conference papers, most from my membership in
  IceCube and P-ONE. {{ stats.curated }} carry a major contribution from me; these are listed first, with my role.
  Papers from experimental collaborations are <a href="#experiments">grouped by experiment</a> below.
  The complete record is on <a href="https://inspirehep.net/authors/{{ profile.ids.inspire_recid }}">INSPIRE</a>.
</p>

<section class="stats" aria-label="Citation summary">
  {{ stat("{:,}".format(stats.citations), 'citations, all records') }}
  {{ stat(stats.h_index, 'h-index, all records') }}
  {{ stat(stats.citations_main, 'citations, major contributions') }}
  {{ stat(stats.h_index_main, 'h-index, major contributions') }}
</section>

<figure class="chart" id="pubs-chart">
  <figcaption>
    <span class="chart-title">Papers per year <span class="muted">(excluding large-collaboration papers, see table)</span></span>
    <span class="legend" aria-hidden="true">
      <span><i class="swatch s1"></i>Major contribution</span>
      <span><i class="swatch s2"></i>Other small-author</span>
    </span>
  </figcaption>
  <div class="chart-body"></div>
  <details>
    <summary>Show as table</summary>
    <table>
      <thead><tr><th>Year</th><th>Major contribution</th><th>Other small-author</th><th>Experimental collaborations</th></tr></thead>
      <tbody>{% for r in chart_pubs %}<tr><td>{{ r.year }}</td><td>{{ r.main }}</td><td>{{ r.small }}</td><td>{{ r.collab }}</td></tr>{% endfor %}</tbody>
    </table>
  </details>
</figure>

<h2>Major contributions</h2>
{% for status, label in [('sub','Submitted'),('preprint','Preprints'),('pub','Published'),('proc','Proceedings')] %}
{% set group = curated|selectattr('status','equalto',status)|list %}
{% if group %}
<h3>{{ label }}</h3>
<ul class="papers">{% for p in group %}{{ paper(p) }}{% endfor %}</ul>
{% endif %}
{% endfor %}

{% set others = papers|rejectattr('curated')|rejectattr('hidden')|selectattr('experiment','none')|rejectattr('status','equalto','thesis')|list %}
{% if others %}
<h2>Other papers</h2>
<ul class="papers">{% for p in others %}{{ paper(p) }}{% endfor %}</ul>
{% endif %}

<h2 id="experiments">Experimental collaborations</h2>
<p class="muted">Papers from my membership in experimental collaborations, grouped by experiment. Papers with a
substantial contribution from me are shown first, with my role.</p>
{% for e in experiments %}
<section id="exp-{{ e.slug }}">
  <h3>{{ e.name }} <span class="muted">· {{ e.papers|length }} paper{{ 's' if e.papers|length != 1 }}</span></h3>
  {% if e.curated %}<ul class="papers">{% for p in e.curated %}{{ paper(p) }}{% endfor %}</ul>{% endif %}
  {% set rest = e.papers|rejectattr('curated')|list %}
  {% if rest %}
  <details>
    <summary>{{ 'All' if not e.curated else 'Other' }} {{ e.name }} papers ({{ rest|length }})</summary>
    <ul class="papers compact">{% for p in rest %}{{ paper(p) }}{% endfor %}</ul>
  </details>
  {% endif %}
</section>
{% endfor %}
{% endblock %}
{% block scripts %}
<script>window.PUBS = {{ chart_pubs|json }};</script>
<script src="js/charts.js"></script>
{% endblock %}
