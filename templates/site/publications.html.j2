{% extends "base.html.j2" %}
{% from "macros.html.j2" import paper, stat %}
{% block title %}Publications · {{ profile.name }}{% endblock %}
{% block content %}
<h1>Publications</h1>
{% set led = curated|selectattr('roles')|selectattr('roles', 'contains', 'idea')|list %}
{% set further = curated|reject('in', led)|list %}
<p class="lede">
  My own research program: {{ led|length }} papers built on ideas I developed, and {{ further|length }} further
  papers with a major contribution from me. Each paper is tagged with my role. In phenomenology, author lists are
  often alphabetical, so the tags, not the author order, show who led the work.
  Papers from my membership in IceCube, P-ONE and Borexino are <a href="#experiments">listed separately</a>; the
  complete record is on <a href="https://inspirehep.net/authors/{{ profile.ids.inspire_recid }}">INSPIRE</a>.
</p>

<section class="stats" aria-label="Publication summary">
  {{ stat(stats.curated, 'papers with a major contribution from me') }}
  {{ stat(stats.citations_main, 'citations of those papers') }}
  {{ stat("{:,}".format(stats.citations), 'citations across all ' ~ stats.records ~ ' papers') }}
  {{ stat(stats.h_index, 'h-index across all ' ~ stats.records ~ ' papers') }}
</section>

<p class="role-legend">
  <span class="role role-wrote">Co-wrote the paper</span> written or co-written by me
  <span class="role role-idea">Developed the idea</span> my idea, or developed by me
  <span class="role role-mentored">Mentored student</span> a student I mentored worked on or led it
</p>

<h2>Papers I led</h2>
<ul class="papers">{% for p in led %}{{ paper(p) }}{% endfor %}</ul>

<h2>Further major contributions</h2>
<ul class="papers">{% for p in further %}{{ paper(p) }}{% endfor %}</ul>

{% set others = papers|rejectattr('curated')|rejectattr('hidden')|selectattr('experiment','none')|rejectattr('status','equalto','thesis')|list %}
{% if others %}
<h2>Other papers</h2>
<ul class="papers">{% for p in others %}{{ paper(p) }}{% endfor %}</ul>
{% endif %}

<h2 id="experiments">Experimental collaborations</h2>
<p class="muted">Papers from my membership in experimental collaborations, grouped by experiment. Papers with a
substantial contribution from me are shown first, with my role.</p>
{% for e in experiments %}
<section id="exp-{{ e.slug }}">
  <h3>{{ e.name }} <span class="muted">· {{ e.papers|length }} paper{{ 's' if e.papers|length != 1 }}</span></h3>
  {% if e.curated %}<ul class="papers">{% for p in e.curated %}{{ paper(p) }}{% endfor %}</ul>{% endif %}
  {% set rest = e.papers|rejectattr('curated')|list %}
  {% if rest %}
  <details>
    <summary>{{ 'All' if not e.curated else 'Other' }} {{ e.name }} papers ({{ rest|length }})</summary>
    <ul class="papers compact">{% for p in rest %}{{ paper(p) }}{% endfor %}</ul>
  </details>
  {% endif %}
</section>
{% endfor %}
{% endblock %}
