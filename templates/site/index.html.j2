{% extends "base.html.j2" %}
{% from "macros.html.j2" import paper, stat %}
{% block content %}
<section class="hero">
  {% if profile.photo %}<img class="portrait" src="{{ profile.photo }}" alt="Portrait of {{ profile.name }}">{% endif %}
  <div>
    <h1>{{ profile.name }}</h1>
    <p class="lede">{{ profile.position }}<br>{{ profile.affiliation }}</p>
    <p>{{ profile.bio|md }}</p>
    <p class="links">
      <a class="button" href="mailto:{{ profile.email }}">Email</a>
      {% for l in profile.links %}<a class="button" href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
      <a class="button" href="cv.html">CV</a>
    </p>
  </div>
</section>

<section class="stats" aria-label="At a glance">
  {{ stat(stats.curated, 'papers with a major contribution') }}
  {{ stat(stats.records, 'records on INSPIRE') }}
  {{ stat("{:,}".format(stats.citations), 'citations across all papers (INSPIRE)') }}
  {{ stat(stats.invited_talks, 'invited talks and seminars') }}
</section>

<section>
  <h2>Research</h2>
  <ul class="theme-links">
    {% for t in research.themes if not t.minor %}
    <li><a href="research.html#{{ t.id }}">{{ t.title }}</a></li>
    {% endfor %}
  </ul>
</section>

<section>
  <h2>Recent papers</h2>
  <ul class="papers">
    {% for p in papers if (p.curated or p.author_count <= 30) and not p.hidden and p.status != 'thesis' %}
    {% if loop.index <= 5 %}{{ paper(p, contribution=false) }}{% endif %}
    {% endfor %}
  </ul>
  <p><a href="publications.html">All publications →</a></p>
</section>

<section>
  <h2>Recent talks</h2>
  <ul class="plain">
    {% for t in talks.talks[:4] %}
    <li><strong>{{ t.event }}</strong>, {{ t.city }}{% if t.country %}, {{ t.country }}{% endif %}, {{ t.year }}. <em>{{ t.title }}</em></li>
    {% endfor %}
  </ul>
  <p><a href="talks.html">All talks →</a></p>
</section>
{% endblock %}
