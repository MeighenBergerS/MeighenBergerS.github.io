{% extends "base.html.j2" %}
{% block title %}{{ post.title|striptags }} · {{ profile.name }}{% endblock %}
{% block meta %}
  <meta property="og:title" content="{{ post.title }}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ profile.site_url }}/{{ post.url }}">
  {% if post.image %}<meta property="og:image" content="{{ profile.site_url }}/{{ post.image }}">{% endif %}
  <meta property="og:description" content="{{ post.excerpt|striptags|truncate(200) }}">
{% endblock %}
{% block content %}
<article class="post">
  <p class="news-meta"><a href="{{ root }}news.html">← News</a> · <span class="news-date">{{ post.date|nicedate }}</span></p>
  <h1>{{ post.title }}</h1>
  {% if post.image %}
  <figure class="post-figure">
    <img src="{{ root }}{{ post.image }}" alt="{{ post.image_alt or '' }}">
    {% if post.caption %}<figcaption>{{ post.caption|md }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="post-body">{{ post.body_html|safe }}</div>
  {% set p = post.paper_obj %}
  {% set sw = post.software_obj %}
  {% if p or sw %}
  <aside class="post-links">
    {% if p %}
    <p class="post-ref"><strong>{{ p.title }}</strong><br>
      <span class="muted">{{ p.venue or ('Preprint, ' ~ p.year) }}</span></p>
    <p class="links">
      {% if p.arxiv %}<a class="button primary" href="https://arxiv.org/abs/{{ p.arxiv }}">arXiv:{{ p.arxiv }}</a>{% endif %}
      {% if p.doi %}<a class="button" href="https://doi.org/{{ p.doi }}">Journal</a>{% endif %}
      {% if p.recid %}<a class="button" href="{{ p.url }}">INSPIRE</a>{% endif %}
    </p>
    {% endif %}
    {% if sw %}
    <p class="links">
      {% if sw.docs %}<a class="button primary" href="{{ sw.docs }}">{{ sw.name }} docs</a>{% endif %}
      <a class="button" href="https://github.com/{{ sw.repo }}">GitHub</a>
      {% if sw.github.pypi %}<a class="button" href="{{ sw.github.pypi.url }}">PyPI</a>{% endif %}
    </p>
    {% endif %}
  </aside>
  {% endif %}
</article>
{% endblock %}
